# LLM backend -- any OpenAI-compatible endpoint.
# Switching provider is these three variables; no code change needed.

# --- Local Ollama (default; free, offline) ---
LLM_BASE_URL=http://localhost:11434/v1
LLM_API_KEY=ollama
LLM_MODEL=llama3.1-8b-ctx8k:latest

# --- OpenRouter (hosted; use for quality runs and demos) ---
# LLM_BASE_URL=https://openrouter.ai/api/v1
# LLM_API_KEY=sk-or-v1-...
# LLM_MODEL=meta-llama/llama-3.3-70b-instruct

# --- Together AI ---
# LLM_BASE_URL=https://api.together.xyz/v1
# LLM_API_KEY=...
# LLM_MODEL=meta-llama/Llama-3.3-70B-Instruct-Turbo

# Sampling temperature (optional, default 0.7)
# LLM_TEMPERATURE=0.7
